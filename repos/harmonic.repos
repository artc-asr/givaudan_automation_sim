# Underlay: gz_ros2_control for Gazebo Harmonic (all robots, rochestra D19). apt's
# gz_ros2_control on Humble is built against Fortress, so build this one with
# GZ_VERSION=harmonic.
# Pin from rochestra.repos.
repositories:
  gz_ros2_control:
    type: git
    url: https://github.com/ros-controls/gz_ros2_control.git
    version: c88a5fd9170af120c263c1201f0744a40f93d673
